# Configure through your hosting provider's server runtime environment.
# Keep values out of Git and browser bundles. This is a comma-separated allowlist
# of verified canonical RMT user IDs from /api/session. A Firebase account uses
# its exact firebase:<uid> identity, not its email address or display name.
RMT_ADMIN_USER_IDS=

# Optional exact-ID access for the existing Dot review monitor. This permits
# MCP digest reads and alert acknowledgements only, never website administration.
RMT_REVIEW_MONITOR_USER_IDS=

# Optional owner alerts. All values stay blank until explicitly configured.
# Use server runtime secrets/bindings; none are NEXT_PUBLIC_ variables.
# HTTPS deployment URL, no query/hash; alerts link to its #review workspace.
RMT_PUBLIC_URL=
RMT_NOTIFICATION_EMAIL=
RMT_EMAIL_FROM=
RESEND_API_KEY=
# Phone/SMS delivery is disabled. Dot monitoring uses the authenticated Site
# connection and restricted monitor allowlist above; no phone or token is needed.
# See docs/notifications.md for setup, retry limits and uncertain outcomes.

# Sites provisions the DB binding from .openai/hosting.json.
# For another host, implement a verified authentication adapter before enabling
# write routes. Do not trust visitor-supplied oai-authenticated-* headers directly.
